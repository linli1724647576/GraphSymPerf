# GraphSymPerf local runtime environment — example.
# Copy to .env and adjust for your machine.
# All values below match infra/docker-compose.graphdbs.yml.

# Local write guards.
# Set to 1 for disposable local smoke databases when using --load.
GRAPHSYMPERF_ALLOW_LOAD=1
# Keep known-issue replay disabled unless you explicitly run destructive replay.
GRAPHSYMPERF_REPLAY_ALLOW_DESTRUCTIVE=0

# Neo4j, container graphsymperf-neo4j, ports 7474 and 7687.
GRAPHSYMPERF_NEO4J_URI=bolt://127.0.0.1:7687
GRAPHSYMPERF_NEO4J_USER=neo4j
GRAPHSYMPERF_NEO4J_PASSWORD=graphsymperf_neo4j
GRAPHSYMPERF_NEO4J_DATABASE=neo4j

# Isolated Neo4j proxy used for LadybugDB GDsmith generation (Neo4j backend).
GRAPHSYMPERF_GDSMITH_PROXY_LADYBUGDB_URI=bolt://127.0.0.1:7697
GRAPHSYMPERF_GDSMITH_PROXY_LADYBUGDB_USER=neo4j
GRAPHSYMPERF_GDSMITH_PROXY_LADYBUGDB_PASSWORD=graphsymperf_ladybug_proxy
# Apache AGE proxy GDsmith: must use a PostgreSQL URI (AgensGraph backend), not bolt://.
# Dedicated AgensGraph instance used only for Apache AGE generation.
GRAPHSYMPERF_GDSMITH_PROXY_APACHE_AGE_URI=postgresql://postgres:graphsymperf_age_proxy@127.0.0.1:5457/postgres
GRAPHSYMPERF_GDSMITH_PROXY_APACHE_AGE_USER=postgres
GRAPHSYMPERF_GDSMITH_PROXY_APACHE_AGE_PASSWORD=graphsymperf_age_proxy

# Memgraph, container graphsymperf-memgraph, Bolt port 7688.
GRAPHSYMPERF_MEMGRAPH_HOST=127.0.0.1
GRAPHSYMPERF_MEMGRAPH_PORT=7688
GRAPHSYMPERF_MEMGRAPH_USER=
GRAPHSYMPERF_MEMGRAPH_PASSWORD=

# FalkorDB, container graphsymperf-falkordb, Redis port 6389.
GRAPHSYMPERF_FALKORDB_HOST=127.0.0.1
GRAPHSYMPERF_FALKORDB_PORT=6389
GRAPHSYMPERF_FALKORDB_GRAPH=graph_sym_perf
GRAPHSYMPERF_FALKORDB_USER=
GRAPHSYMPERF_FALKORDB_PASSWORD=

# AgensGraph, container graphsymperf-agensgraph, PostgreSQL port 5456.
GRAPHSYMPERF_AGENSGRAPH_URI=postgresql://postgres:graphsymperf_agens@127.0.0.1:5456/postgres
GRAPHSYMPERF_AGENSGRAPH_GRAPH=graph_sym_perf
GRAPHSYMPERF_AGENSGRAPH_USER=postgres
GRAPHSYMPERF_AGENSGRAPH_PASSWORD=graphsymperf_agens
GRAPHSYMPERF_AGENSGRAPH_DATABASE=postgres

# ArcadeDB, container graphsymperf-arcadedb, HTTP port 2481, PostgreSQL-wire port 5433.
GRAPHSYMPERF_ARCADEDB_HTTP_URL=http://127.0.0.1:2481
GRAPHSYMPERF_ARCADEDB_DATABASE=mydb
GRAPHSYMPERF_ARCADEDB_USER=root
GRAPHSYMPERF_ARCADEDB_PASSWORD=playwithdata
GRAPHSYMPERF_ARCADEDB_BOLT_HOST=127.0.0.1
GRAPHSYMPERF_ARCADEDB_BOLT_PORT=2425
GRAPHSYMPERF_ARCADEDB_POSTGRES_HOST=127.0.0.1
GRAPHSYMPERF_ARCADEDB_POSTGRES_PORT=5433

# Apache AGE, container graphsymperf-apache-age, PostgreSQL port 5455.
GRAPHSYMPERF_APACHE_AGE_URI=postgresql://postgres:graphsymperf_age@127.0.0.1:5455/postgres
GRAPHSYMPERF_APACHE_AGE_GRAPH=graph_sym_perf
GRAPHSYMPERF_APACHE_AGE_USER=postgres
GRAPHSYMPERF_APACHE_AGE_PASSWORD=graphsymperf_age
GRAPHSYMPERF_APACHE_AGE_DATABASE=postgres

# LadybugDB embedded database. Not a Docker service.
GRAPHSYMPERF_LADYBUGDB_DATABASE_PATH=/tmp/graphsymperf-ladybugdb
GRAPHSYMPERF_LADYBUGDB_PACKAGE_DIGEST=sha256:<installed-ladybug-distribution-digest>

# GDsmith. Set the path to your local GDsmith JAR.
GRAPHSYMPERF_GDSMITH_JAR=/path/to/GDsmith.jar
GRAPHSYMPERF_GDSMITH_JAR_SHA256=sha256:<built-jar-digest>
GRAPHSYMPERF_GDSMITH_ALLOW_DESTRUCTIVE=1
GRAPHSYMPERF_GDSMITH_NO_PROXY_LAUNCHER=0

# Actual execution artifact identities. Generate these after `docker compose up`
# with `scripts/render_local_provenance.py`; do not guess values.
GRAPHSYMPERF_NEO4J_CONTAINER=graphsymperf-neo4j
GRAPHSYMPERF_NEO4J_IMAGE_DIGEST=sha256:<docker-image-id>
GRAPHSYMPERF_MEMGRAPH_CONTAINER=graphsymperf-memgraph
GRAPHSYMPERF_MEMGRAPH_IMAGE_DIGEST=sha256:<docker-image-id>
GRAPHSYMPERF_FALKORDB_CONTAINER=graphsymperf-falkordb
GRAPHSYMPERF_FALKORDB_IMAGE_DIGEST=sha256:<docker-image-id>
GRAPHSYMPERF_AGENSGRAPH_CONTAINER=graphsymperf-agensgraph
GRAPHSYMPERF_AGENSGRAPH_IMAGE_DIGEST=sha256:<docker-image-id>
GRAPHSYMPERF_ARCADEDB_CONTAINER=graphsymperf-arcadedb
GRAPHSYMPERF_ARCADEDB_IMAGE_DIGEST=sha256:<docker-image-id>
GRAPHSYMPERF_APACHE_AGE_CONTAINER=graphsymperf-apache-age
GRAPHSYMPERF_APACHE_AGE_IMAGE_DIGEST=sha256:<docker-image-id>
