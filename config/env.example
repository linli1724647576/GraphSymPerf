# Copy required values to a local .env; do not commit credentials.
GRAPHSYMPERF_NEO4J_URI=
GRAPHSYMPERF_NEO4J_USER=
GRAPHSYMPERF_NEO4J_PASSWORD=
GRAPHSYMPERF_MEMGRAPH_HOST=
GRAPHSYMPERF_FALKORDB_HOST=
GRAPHSYMPERF_AGENSGRAPH_URI=
GRAPHSYMPERF_ARCADEDB_HTTP_URL=
GRAPHSYMPERF_APACHE_AGE_URI=
GRAPHSYMPERF_LADYBUGDB_DATABASE_PATH=
# GDsmith has no AGE/LadybugDB provider.  These isolated proxy endpoints are
# required for formal generation and must not share a graph/database slot.
GRAPHSYMPERF_GDSMITH_PROXY_APACHE_AGE_URI=
GRAPHSYMPERF_GDSMITH_PROXY_LADYBUGDB_URI=
GRAPHSYMPERF_GDSMITH_JAR=
