[
  {
    "query": "SHOW INDEXES YIELD name, state, labelsOrTypes, properties WHERE name = 'gsp_cost_lookup' RETURN name, state, labelsOrTypes, properties",
    "expected_rows": [
      {
        "name": "gsp_cost_lookup",
        "state": "ONLINE",
        "labelsOrTypes": [
          "GspAnchor"
        ],
        "properties": [
          "uid"
        ]
      }
    ]
  },
  {
    "query": "MATCH (u:GspAnchor {uid: 1}) RETURN count(u) AS count",
    "expected_rows": [
      {
        "count": 1
      }
    ]
  },
  {
    "query": "MATCH (:GspAnchor {uid: 1})-[:GSP_LOW]->(v:GspLow) RETURN count(v) AS count",
    "expected_rows": [
      {
        "count": 8
      }
    ]
  },
  {
    "query": "MATCH (:GspAnchor {uid: 1})-[:GSP_HIGH]->(w:GspHigh) RETURN count(w) AS count",
    "expected_rows": [
      {
        "count": 200001
      }
    ]
  },
  {
    "query": "MATCH (:GspAnchor {uid: 1})-[:GSP_HIGH]->(w:GspHigh) WHERE w.keep = true RETURN count(w) AS count",
    "expected_rows": [
      {
        "count": 1
      }
    ]
  },
  {
    "query": "MATCH (v:GspLow) RETURN count(DISTINCT v.uid) AS count",
    "expected_rows": [
      {
        "count": 8
      }
    ]
  }
]
