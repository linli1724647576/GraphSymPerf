        "count": 50000
      }
    ]
  },
  {
    "query": "MATCH (u:GspLow {id: 1})-[:GSP_LINK]->(m:GspMiddle {uid: 2})-[:GSP_LINK]->(v:GspHigh {uid: 3}) RETURN u.keep AS u_keep, m.keep AS m_keep, v.keep AS v_keep",
    "expected_rows": [
      {
        "u_keep": true,
        "m_keep": true,
        "v_keep": true
      }
    ]
  },
  {
    "query": "MATCH (:GspLow {id: 1})-[:GSP_LINK]->(:GspMiddle)-[:GSP_LINK]->(:GspHigh) RETURN count(*) AS count",
