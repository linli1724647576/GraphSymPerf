        "properties": [
          "id"
        ]
      }
    ]
  },
  {
    "query": "MATCH (u:GspLow {id: 1}) RETURN count(u) AS count",
    "expected_rows": [
      {
        "count": 1
      }
    ]
  },
  {
    "query": "MATCH (v:GspHigh) RETURN count(v) AS count",
    "expected_rows": [
