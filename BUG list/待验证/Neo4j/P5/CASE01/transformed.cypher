MATCH (u:GspAnchor) WHERE ((COUNT { MATCH (u)-[:GSP_EXPAND]->(gsp_leaf:GspLeaf) WHERE CASE WHEN (u.uid = u.uid) THEN CASE WHEN (u.uid = u.uid) THEN (coalesce(gsp_leaf.mark, false) = true) ELSE null END ELSE null END } > 0) OR CASE WHEN (u.uid = u.uid) THEN CASE WHEN (u.uid = u.uid) THEN (coalesce(u.keep, false) = true) ELSE null END ELSE null END) RETURN u.uid;
